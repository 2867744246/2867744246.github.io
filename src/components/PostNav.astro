---
// 左侧文章导航：列出全部文章（按发布日期倒序），阅读时可随时切换，当前文章高亮
// 仅宽屏（xl 及以上）显示，窄屏空间不足，通过顶部导航的「归档」访问文章列表
import { getCollection } from 'astro:content';

interface Props {
	currentSlug: string;
}

const { currentSlug } = Astro.props;

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<nav
	aria-label="文章目录"
	class="fixed top-20 left-5 hidden w-52 max-h-[calc(100vh-7rem)] overflow-y-auto text-sm xl:block"
>
	<p class="mb-2 text-xs font-semibold text-zinc-400 dark:text-zinc-500">全部文章</p>
	<ul class="space-y-2 border-l border-zinc-200 dark:border-zinc-700">
		{
			posts.map((p) => (
				<li>
					<a
						href={`/posts/${p.id}/`}
						class:list={[
							'block pl-3 hover:text-amber-600 dark:hover:text-amber-400',
							p.id === currentSlug
								? 'font-medium text-amber-600 dark:text-amber-400'
								: 'text-zinc-600 dark:text-zinc-400'
						]}
					>
						{p.data.title}
					</a>
				</li>
			))
		}
	</ul>
</nav>
