---
// 文章目录组件，双形态：
// 1. 宽屏（xl 及以上）：固定在正文右侧空白区，滚动时始终可见，随滚动高亮当前章节
// 2. 窄屏：退化为文章开头的普通目录卡片
// 没有可显示的标题时整体不输出
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
// 只保留 h2/h3：h1 是文章大标题（页面单独渲染），更深层的进目录只会噪音
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	items.length > 0 && (
		<>
			{/* 窄屏形态：文章开头目录卡片，宽屏隐藏 */}
			<nav
				data-toc
				aria-label="目录"
				class="mb-8 rounded-lg border border-zinc-200 bg-zinc-50 p-4 text-sm xl:hidden dark:border-zinc-700 dark:bg-zinc-800/50"
			>
				<p class="mb-2 font-semibold">目录</p>
				<ul class="space-y-1.5">
					{items.map((h) => (
						<li class={h.depth === 3 ? 'ml-4' : ''}>
							<a
								href={`#${h.slug}`}
								class="text-zinc-600 hover:text-amber-600 dark:text-zinc-400 dark:hover:text-amber-400"
							>
								{h.text}
							</a>
						</li>
					))}
				</ul>
			</nav>

			{/* 宽屏形态：固定悬浮在右侧空白区（正文 max-w-3xl 居中后，xl 视口右侧至少留出 256px） */}
			<nav
				data-toc
				aria-label="目录"
				class="fixed top-20 right-5 hidden w-52 max-h-[calc(100vh-7rem)] overflow-y-auto text-sm xl:block"
			>
				<p class="mb-2 text-xs font-semibold text-zinc-400 dark:text-zinc-500">目录</p>
				<ul class="space-y-2 border-l border-zinc-200 dark:border-zinc-700">
					{items.map((h) => (
						<li>
							<a
								href={`#${h.slug}`}
								class:list={['block text-zinc-600 hover:text-amber-600 dark:text-zinc-400 dark:hover:text-amber-400', h.depth === 3 ? 'pl-6' : 'pl-3']}
							>
								{h.text}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<script>
				// 目录滚动高亮（scrollspy）：把"最后一个滚过视口顶部参考线"的标题视为当前章节，
				// 给两份目录里对应的链接加 toc-active 类
				const tocLinks = Array.from(
					document.querySelectorAll<HTMLAnchorElement>('nav[data-toc] a[href^="#"]')
				);
				// 两份目录指向同一批标题，按 id 去重得到实际标题元素（Set 保序）
				const headingEls = [...new Set(tocLinks.map((a) => decodeURIComponent(a.hash.slice(1))))]
					.map((id) => document.getElementById(id))
					.filter((el): el is HTMLElement => el !== null);

				function highlightToc() {
					// 参考线取 120px：略低于顶部导航高度，滚过该线的最近一个标题即当前章节
					let currentId = headingEls[0]?.id ?? '';
					for (const h of headingEls) {
						if (h.getBoundingClientRect().top <= 120) currentId = h.id;
					}
					for (const a of tocLinks) {
						a.classList.toggle('toc-active', decodeURIComponent(a.hash.slice(1)) === currentId);
					}
				}

				document.addEventListener('scroll', highlightToc, { passive: true });
				highlightToc();
			</script>

			<style is:global>
				/* 目录当前章节高亮：亮色 amber-600、暗色 amber-400（作用域限定在目录内） */
				nav[data-toc] a.toc-active {
					color: rgb(217 119 6); /* amber-600 */
					font-weight: 500;
				}
				.dark nav[data-toc] a.toc-active {
					color: rgb(251 191 36); /* amber-400 */
				}
			</style>
		</>
	)
}
